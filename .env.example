# Copy to .env and fill in. Never commit .env, credentials.json or token.json.

# --- Database -----------------------------------------------------------------
# Embedded local PostgreSQL (no install needed); data kept in the folder, port LOCAL_DB_PORT (5433)
DATABASE_URL=pgserver:private/pgdata
# Or any PostgreSQL server:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/recruiter_db

# --- Mock mode ----------------------------------------------------------------
# true = no paid LLM, no real calendar, no real email (everything runs locally).
MOCK_MODE=true
# Optional per-integration overrides (default to MOCK_MODE), e.g. real LLM + mock calendar:
# MOCK_LLM=false
# MOCK_CALENDAR=true
# MOCK_EMAIL=true

# --- LLM ----------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini (LLM_PROVIDER=gemini) - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

LLM_MAX_REPAIR_ATTEMPTS=2
# Hard per-request timeout; on timeout the application is marked ERROR (re-run it later)
LLM_TIMEOUT_SECONDS=90

# --- Google Calendar (interview panel) -----------------------------------------
# Comma-separated calendar ids (usually panel members' emails). All must be free.
# The event is created on the FIRST calendar.
GOOGLE_CALENDAR_IDS=
# OAuth desktop client from Google Cloud Console; run `python -m scripts.google_auth` once
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CREATE_MEET_LINK=true

# --- Email (SMTP) ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_MAX_ATTEMPTS=3
RECRUITER_CONTACT_EMAIL=

# --- App ------------------------------------------------------------------------
# Shared password for HR pages (leave empty only for local demos)
HR_PASSWORD=change-me
RESUME_STORAGE_DIR=private/resumes
MOCK_DATA_DIR=private/mock
MAX_RESUME_SIZE_MB=5

# --- Scheduling policy -----------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
INTERVIEW_DURATION_MINUTES=45
WORKING_HOURS_START=10
WORKING_HOURS_END=18
SLOT_STEP_MINUTES=30
SCHEDULING_HORIZON_DAYS=10
MIN_NOTICE_HOURS=24
MAX_PROPOSED_SLOTS=8

# --- Screening policy -------------------------------------------------------------
COUNT_INTERNSHIPS_AS_EXPERIENCE=false
# true = ELIGIBLE candidates move to APPROVED without an HR click
AUTO_APPROVE_ELIGIBLE=false
# Days a rejected candidate must wait before applying to the same job again (0 = immediately)
REAPPLY_COOLDOWN_DAYS=0
